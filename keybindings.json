    },
    {
        "key": "shift+cmd+backspace",
        "command": "-editor.action.inlineDiffs.cancelEdits",
        "when": "editorTextFocus && hasActivelyGeneratingDiff"
    },
    {
        "key": "cmd+-",
        "command": "editor.fold",
        "when": "editorTextFocus && foldingEnabled"
    },
    {
        "key": "alt+cmd+[",
