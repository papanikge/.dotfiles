{
    "vim.sneak": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<leader>",
                "d"
            ],
            "after": [
                "d",
                "d"
            ]
        },
        {
            "before": [
                "<C-n>"
            ],
            "commands": [
                ":nohl"
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        },
        {
            "before": [
                "g",
                "t"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ],
            "silent": true
        },
        {
            "before": [
                "<Tab>"
            ],
            "commands": [
                "workbench.action.nextEditor"
            ],
            "silent": true
        },
        {
            "before": [
                "<S-Tab>"
            ],
            "commands": [
                "workbench.action.previousEditor"
            ],
            "silent": true
        },
        {
            "before": [
                "<leader>",
                "<space>"
            ],
            "commands": [
                ":nohl",
            ]
        },
        {
            "before": [
                "<leader>",
                "m"
            ],
            "commands": [
                "bookmarks.toggle"
            ]
        },
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "bookmarks.list"
            ]
        },
        {
            "before": [
                ":"
            ],
            "commands": [
                "workbench.action.showCommands",
            ],
            "silent": true
        },
        {
            "before": [
                "=",
                "="
            ],
            "commands": [
               "editor.action.formatDocument"
            ]
        },
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                "g",
                "s"
            ],
            "commands": [
                "extension.searchUnderCursor"
            ]
        },
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "gitlens.toggleFileBlame"
            ]
        },
        {
            "before": [
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        }
    ],
    "vim.leader": ",",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false
    },
    "editor.fontSize": 15,
    "files.autoSave": "afterDelay",
    "editor.inlineSuggest.enabled": true,
    "editor.fontFamily": "Iosevka, Menlo, Monaco, 'Courier New', monospace",
    "go.toolsManagement.autoUpdate": true,
    "githubPullRequests.pullBranch": "never",
    "terminal.integrated.fontSize": 15,
    "git.blame.editorDecoration.enabled": false,
    "git.openRepositoryInParentFolders": "never",
    "python.createEnvironment.trigger": "off",
    "cursor.composer.cmdPFilePicker2": true,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.codeLens.enabled": false,
    "gitlens.hovers.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.iconTheme": "ayu",
    "zig.zls.enabled": "on",
    "makefile.configureOnOpen": true,
    "workbench.preferredLightColorTheme": "Vibe Out West Light",
    "python.terminal.activateEnvironment": false,
    "workbench.colorTheme": "Cursor Dark",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "editor.renderControlCharacters": false
}
